# Copy to manager.env and point to your official Strata source checkout.
# Example only: replace this path with your actual installation.
STRATA_ROOT=C:/path/to/Strata
STRATA_API=http://127.0.0.1:8080
MANAGER_PORT=8275
# Strata's component folder (engine packages); default: <STRATA_ROOT>/components
# STRATA_COMPONENTS_DIR=C:/path/to/Strata/components
# Your own launch profiles, and the TUI's generated run configs, engine logs and remembered engine version.
# Keep both OUTSIDE the Strata folder so an update never touches them. Defaults: C:\AI\strata-tui\profiles and ...\state
# STRATA_TUI_PROFILES=C:/AI/strata-tui/profiles
# STRATA_TUI_STATE=C:/AI/strata-tui/state
